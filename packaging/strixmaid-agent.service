[Unit]
Description=StrixMaid agent
Documentation=https://github.com/kylinholmes/Strix
After=network-online.target
Wants=network-online.target
# 没写配置就不启动(status 显示 condition failed,而不是每 2 秒崩一次刷日志)。
# server_url 与 token 没有可猜的默认值,起了也只会立即退出。
# 纯环境变量部署(STRIXMAID_AGENT_*)可用 drop-in 覆盖掉这行。
ConditionPathExists=/etc/strixmaid/agent.toml
# 配置错误是确定性失败,重启多少次都一样:一分钟内崩 5 次就停下等人来修
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# 2026-09-17 起 Agent 与 Server 是同一个二进制的两种模式（design.md §11）。
# 旧版这里是 /usr/bin/strixmaid-agent，升级时该文件会被删掉。
ExecStart=/usr/bin/strixmaid agent
Restart=on-failure
RestartSec=2
StateDirectory=strixmaid-agent
Environment=RUST_LOG=info
KillMode=control-group
TimeoutStopSec=20
# Agent 只读采集，不需要 root；但读全量 /proc 与 /sys 的部分项时权限更全。
# 需要收紧时可加 DynamicUser=yes 并接受部分指标缺失。

[Install]
WantedBy=multi-user.target
